# Copy to api/.env for local dev, or set these as env vars on your host.

# --- LLM provider ---
# groq (default) | gemini | anthropic | openai | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...

# --- Admin dashboard (CHANGE BEFORE EXPOSING PUBLICLY) ---
ADMIN_USER=admin
ADMIN_PASS=change-this-strong-password

# --- Analytics (optional) ---
# PostHog project key (public/client-side). Set this to enable product analytics.
# POSTHOG_KEY=phc_xxxxxxxx
# POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com
# APP_VERSION=0.1.0

# --- Server ---
PORT=5175
# NODE_ENV=production            # set on your host; enables single-service + security warnings
# WEB_DIST=../web/dist           # path to the built SPA (the Docker image sets this)

# --- Demo seed (optional) ---
# SEED_BASE=http://127.0.0.1:5175  # target URL for `npm run seed`
